DATABASE_PASSWORD=replace-with-a-long-random-password
# Generate 32 random bytes encoded as Base64 (see README).
JWT_SECRET=
PORT=3000
# Core CRUD and tests run without AI credentials.
AI_ENABLED=false
AI_PROVIDER=hosted
AI_URL=https://openrouter.ai/api/v1
# Server-only secret. Never use a VITE_ prefix or commit your real .env.
AI_API_KEY=
AI_MODEL=google/gemini-2.5-flash-lite
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
